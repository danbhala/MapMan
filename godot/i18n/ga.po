msgstr[1] "SLÁN! AR AIS I gCEANN %d BHOGADH"
msgstr[2] "SLÁN! AR AIS I gCEANN %d BHOGADH"
msgstr[3] "SLÁN! AR AIS I gCEANN %d mBOGADH"
