#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "SKELETON"
msgstr "CNÁMHARLACH"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); pith helmet, compass and a map
msgid "EXPLORER"
msgstr "TAISCÉALAÍ"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "ASTRONAUT"
msgstr "SPÁSAIRE"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "ROBOT"
msgstr "RÓBAT"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "SUPERHERO"
msgstr "SÁRLAOCH"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "WIZARD"
msgstr "DRAOI"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); MapMan made of gold
msgid "SOLID GOLD"
msgstr "ÓR GLAN"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); a name: keep MAPWOMAN, as MAPMAN is kept
msgid "MAPWOMAN"
msgstr "MAPWOMAN"

#. Wardrobe: how rare a look is, as in collectible games
msgid "COMMON"
msgstr "COITIANTA"

#. Wardrobe: how rare a look is, as in collectible games
msgid "UNCOMMON"
msgstr "NEAMHGHNÁCH"

#. Wardrobe: how rare a look is, as in collectible games
msgid "RARE"
msgstr "ANNAMH"

#. Wardrobe: how rare a look is, as in collectible games
msgid "EPIC"
msgstr "EIPICIÚIL"

#. Wardrobe: how rare a look is, as in collectible games
msgid "LEGENDARY"
msgstr "FINSCÉALACH"

#. Wardrobe: how rare a look is, as in collectible games
msgid "SPECIAL"
msgstr "SPEISIALTA"

#. Main menu row and sheet title: where MapMan's looks are kept and chosen
msgid "WARDROBE"
msgstr "VARDRÚS"

#. Wardrobe note: looks released so far out of all of them, e.g. 10 OF 22 RELEASED; n is the first number
msgid "%d OF %d RELEASED"
msgid_plural "%d OF %d RELEASED"
msgstr[0] "%d AS %d SCAOILTE"
msgstr[1] "%d AS %d SCAOILTE"
msgstr[2] "%d AS %d SCAOILTE"
msgstr[3] "%d AS %d SCAOILTE"
msgstr[4] "%d AS %d SCAOILTE"

#. Wardrobe note: tap a released look to put it on
msgid "TAP ONE TO WEAR IT"
msgstr "TAPÁIL LENA CHAITHEAMH"

#. Wardrobe cell: the level whose first clear releases this look, e.g. LV 35; very short
msgid "LV %d"
msgstr "L. %d"

#. Wardrobe cell for Classic: in the wardrobe from the start
msgid "START"
msgstr "TÚS"

#. Wardrobe cell for MapWoman: released by finishing the game
msgid "THE END"
msgstr "CRÍOCH"

#. Rubber stamp: the look MapMan is wearing
msgid "WORN"
msgstr "IN ÚSÁID"

#. Small tag on the main menu: a look not yet seen in the wardrobe
msgid "NEW"
msgstr "NUA"

#. Wardrobe: when this look was released
msgid "RELEASED AT LEVEL %d"
msgstr "SCAOILTE AG LEIBHÉAL %d"

#. Wardrobe: Classic's line
msgid "IN THE WARDROBE FROM THE START"
msgstr "SA VARDRÚS ÓN TÚS"

#. Wardrobe: MapWoman's line
msgid "RELEASED FOR FINISHING THE GAME"
msgstr "SCAOILTE AG DEIREADH AN CHLUICHE"

#. Slip on the level-clear sheet: a look was just released
msgid "NEW IN THE WARDROBE"
msgstr "NUA SA VARDRÚS"

#. Button on the level-clear slip: wear the look just released, now
msgid "WEAR IT"
msgstr "CAITH É"

#. Slip on the last sheet: MapWoman can now be worn; keep MAPWOMAN
msgid "MAPWOMAN JOINS THE WARDROBE"
msgstr "TÁ MAPWOMAN SA VARDRÚS ANOIS"

#. Slip on the last sheet: wearing MapWoman, MapMan is the one waiting at the end; keep MAPMAN
msgid "PLAY AS HER: MAPMAN WAITS FOR YOU AT THE END"
msgstr "IMIR MAR Í: FANANN MAPMAN LEAT AG AN DEIREADH"

#. Screen reader name of the main menu's wardrobe row
msgid "Wardrobe, %d of %d released"
msgstr "Vardrús, %d as %d scaoilte"

#. Screen reader: a look's name, and that MapMan wears it
msgid "%s, worn"
msgstr "%s, in úsáid"

#. Screen reader: a look not released yet
msgid "Locked, released at level %d"
msgstr "Faoi ghlas, scaoilfear ag leibhéal %d"

#. Screen reader: MapWoman before the game is finished
msgid "Locked, released for finishing the game"
msgstr "Faoi ghlas, scaoilfear ag an deireadh"

#. Level clear button, under MapMan: plays every try at the level back at once
msgid "WATCH REPLAY"
msgstr "FÉACH ATHIMRT"

#. Heading of the replay of every try at a level (%d is the level number)
msgid "REPLAY — LEVEL %d"
msgstr "ATHIMRT — LEIBHÉAL %d"

#. Under the replay heading: how many tries at the level it shows
msgid "%d TRY"
msgid_plural "%d TRIES"
msgstr[0] "%d IARRACHT"
msgstr[1] "%d IARRACHT"
msgstr[2] "%d IARRACHT"
msgstr[3] "%d IARRACHT"
msgstr[4] "%d IARRACHT"

#. Options row: a faint MapMan replays your best run of the level beside you
msgid "BEST-RUN GHOST"
msgstr "TAIBHSE IS FEARR"

#. Title screen at launch, under the big MAPMAN title: tap anywhere to go on to the main menu. The phone version of an arcade PRESS START.
msgid "TAP TO START"
msgstr "TAPÁIL LE TOSÚ"

#. Title screen at launch: small corner note while the intro plays; tapping anywhere skips it to the title. Also the corner button in the tutorial a first-time player is taken to, back to the main menu
msgid "SKIP"
msgstr "LÉIM"

#. Main menu item and sheet title: where players draw their own levels, beat them and share them as a code. A drafting table is an architect's drawing desk.
msgid "DRAFTING TABLE"
msgstr "BORD LÍNÍOCHTA"

#. Main menu row, shown once the game has been finished: the second game, the same sheets mirrored and reworked with new tiles. 'Revision B' is a drawing-sheet revision letter; keep 'B'.
msgid "PLAY REVISION B"
msgstr "IMIR LEASÚ B"

#. Title of Revision B's checkpoints sheet.
msgid "REVISION B"
msgstr "LEASÚ B"

#. Column header of Revision B's checkpoints sheet.
msgid "THE SHEETS AGAIN: FROM A SAVED CHECKPOINT"
msgstr "NA BILEOGA ARÍS: Ó PHOINTE SÁBHÁILTE"

#. Row on Revision B's checkpoints sheet: start it from the first sheet.
msgid "PLAY FROM SHEET 001"
msgstr "IMIR Ó BHILEOG 001"

#. Stamp on the congratulations sheet the first time the game is finished: Revision B has opened.
msgid "REV B RELEASED"
msgstr "LEASÚ B EISITHE"

#. Stamp on the congratulations sheet on finishing Revision B.
msgid "REV B APPROVED"
msgstr "LEASÚ B CEADAITHE"

#. Drafting table: heading over the six levels the player is drawing
msgid "YOUR DRAFTS"
msgstr "DO DHRÉACHTAÍ"

#. Drafting table: heading over levels other players sent as codes
msgid "RECEIVED LEVELS"
msgstr "LEIBHÉIL A FUARTHAS"

#. Drafting table: shown while no level has been received yet
msgid "LEVELS FRIENDS SEND YOU APPEAR HERE"
msgstr "TAISPEÁNTAR LEIBHÉIL Ó CHAIRDE ANSEO"

#. Drafting table: a draft slot with nothing drawn in it (small cell)
msgid "EMPTY"
msgstr "FOLAMH"

#. Drafting table: a draft slot with a level in it that its maker hasn't beaten yet (small cell)
msgid "DRAFT"
msgstr "DRÉACHT"

#. Drafting table: a draft its maker has beaten, so it can be shared, like an approved drawing (small cell, also a stamp)
msgid "SIGNED"
msgstr "SÍNITHE"

#. Drafting table item: type or paste a code a friend sent, to play their level
msgid "ENTER A LEVEL CODE"
msgstr "CUIR ISTEACH CÓD"

#. Drafting table note: the three steps of making a level
msgid "DRAW A LEVEL · BEAT IT · SHARE ITS CODE"
msgstr "TARRAING LEIBHÉAL · CRÍOCHNAIGH É · ROINN A CHÓD"

#. Drafting table note after beating a level a friend sent: the seconds left on the clock (%d)
msgid "LEVEL CLEARED WITH %ds LEFT"
msgstr "LEIBHÉAL CRÍOCHNAITHE, %ds FÁGTHA"

#. Sheet title: the screen for typing or pasting a level code
msgid "LEVEL CODE"
msgstr "CÓD LEIBHÉIL"

#. Level code sheet: instruction above the text box
msgid "TYPE OR PASTE A LEVEL CODE"
msgstr "CLÓSCRÍOBH NÓ GREAMAIGH CÓD"

#. Level code sheet button: paste the clipboard into the text box
msgid "PASTE"
msgstr "GREAMAIGH"

#. Level code sheet item: play the level the code describes
msgid "PLAY THIS LEVEL"
msgstr "IMIR AN LEIBHÉAL SEO"

#. Level code sheet: the code has a typo or isn't a level code
msgid "THAT CODE DOESN'T READ. CHECK IT AND TRY AGAIN"
msgstr "NÍ LÉITEAR AN CÓD SIN. SEICEÁIL É AGUS TRIAIL ARÍS"

#. Level code sheet: the code was made by a later version of the game. Keep MAPMAN.
msgid "THIS LEVEL NEEDS A NEWER VERSION OF MAPMAN"
msgstr "TEASTAÍONN LEAGAN NÍOS NUAÍ DE MAPMAN"

#. Sheet title shown when the game opens with a copied level code: offer to play it
msgid "A LEVEL CODE IS ON THE CLIPBOARD"
msgstr "TÁ CÓD LEIBHÉIL CÓIPEÁILTE"

#. Item: play the level from the copied code
msgid "PLAY IT"
msgstr "IMIR É"

#. Item: ignore the copied code
msgid "NOT NOW"
msgstr "NÍ ANOIS"

#. Editor title: which of the six drafts is open (%d is 1 to 6)
msgid "DRAFT %d"
msgstr "DRÉACHT %d"

#. Editor button: leave the editor (the draft is kept)
msgid "BACK"
msgstr "AR AIS"

#. Editor button: take back the last stroke
msgid "UNDO"
msgstr "CEALAIGH"

#. Editor button: play the draft; reaching an exit signs it
msgid "TEST"
msgstr "TÁSTÁIL"

#. Editor button: show the draft's code and QR code (only once it is signed)
msgid "SHARE"
msgstr "ROINN"

#. Editor: small label over the meter showing how long the draft's code is
msgid "CODE"
msgstr "CÓD"

#. Editor status: the draft has no start tile yet
msgid "PLACE ONE START TILE"
msgstr "CUIR TÍL THOSAIGH AMHÁIN"

#. Editor status: the draft has no exit yet
msgid "PLACE AT LEAST ONE EXIT"
msgstr "CUIR BEALACH AMACH AMHÁIN AR A LAGHAD"

#. Editor status: the draft can be played; beating it signs it so it can be shared
msgid "TEST IT AND REACH AN EXIT TO SIGN IT"
msgstr "TÁSTÁIL É, SROICH BEALACH AMACH, SÍNIGH É"

#. Editor status: the draft has been beaten and can be shared
msgid "SIGNED · READY TO SHARE"
msgstr "SÍNITHE · RÉIDH LE ROINNT"

#. Editor: name of a vanishing tile, which disappears for %d moves after MapMan steps off it
msgid "VANISH · %d MOVE"
msgid_plural "VANISH · %d MOVES"
msgstr[0] "IMÍONN · %d BHOGADH"
msgstr[1] "IMÍONN · %d BHOGADH"
msgstr[2] "IMÍONN · %d BHOGADH"
msgstr[3] "IMÍONN · %d mBOGADH"
msgstr[4] "IMÍONN · %d BOGADH"

#. Share sheet: how a friend gets the level, with no accounts or internet: scan the QR code or send the text code
msgid "SCAN THE QR WITH A PHONE CAMERA, OR SEND THE CODE"
msgstr "SCANAIGH AN QR LE CEAMARA FÓIN, NÓ SEOL AN CÓD"

#. Share sheet item: copy the level code to the clipboard
msgid "COPY CODE"
msgstr "CÓIPEÁIL CÓD"

#. Share sheet: confirms the code is on the clipboard
msgid "CODE COPIED"
msgstr "CÓD CÓIPEÁILTE"

#. Share sheet item: return to the editor
msgid "BACK TO THE DRAFT"
msgstr "AR AIS GO DTÍ AN DRÉACHT"

#. Pause sheet while testing a draft (%d is 1 to 6). Same wording as WORK SUSPENDED · TUTORIAL.
msgid "WORK SUSPENDED · DRAFT %d"
msgstr "OBAIR AR FIONRAÍ · DRÉACHT %d"

#. Pause sheet while playing a level from a code. Same wording as WORK SUSPENDED · TUTORIAL.
msgid "WORK SUSPENDED · RECEIVED LEVEL"
msgstr "OBAIR AR FIONRAÍ · LEIBHÉAL FAIGHTE"

#. Editor palette: clears tiles
msgid "ERASER"
msgstr "SCRIOSÁN"

#. Editor palette: a plain tile MapMan can walk on
msgid "PATH"
msgstr "CONAIR"

#. Editor palette: where MapMan starts (one per level)
msgid "START TILE"
msgstr "TÍL THOSAIGH"

#. Editor palette: a level exit (one for each direction)
msgid "EXIT"
msgstr "BEALACH AMACH"

#. Editor palette: a tile that costs a life
msgid "DEATH TILE"
msgstr "TÍL BHÁIS"

#. Editor palette: a star to collect
msgid "STAR"
msgstr "RÉALTA"

#. Editor palette: a tile that holds MapMan until the player shakes or taps
msgid "STICKY TILE"
msgstr "TÍL GHREAMAITHEACH"

#. Editor palette: a tile that reverses the controls
msgid "REVERSE TILE"
msgstr "TÍL AISIOMPAITHE"

#. Editor palette: a tile that hides the hideable tiles when stepped on
msgid "HIDE TILES"
msgstr "FOLAIGH TÍLEANNA"

#. Editor palette: a tile that shows the hidden tiles again
msgid "UNHIDE TILES"
msgstr "NOCHT TÍLEANNA"

#. Editor palette: a path tile that is never drawn
msgid "INVISIBLE PATH"
msgstr "CONAIR DHOFHEICTHE"

#. Editor palette: a star that disappears while tiles are hidden
msgid "HIDEABLE STAR"
msgstr "RÉALTA IN-FHOLAITHE"

#. Editor palette: a death tile that disappears while tiles are hidden
msgid "HIDEABLE DEATH TILE"
msgstr "TÍL BHÁIS IN-FHOLAITHE"

#. Editor palette: an extra life that disappears while tiles are hidden
msgid "HIDEABLE EXTRA LIFE"
msgstr "BEATHA BHREISE IN-FHOLAITHE"

#. Editor palette: marks tiles that are hidden when the level begins
msgid "STARTS HIDDEN"
msgstr "I bhFOLACH AG TÚS"

#. Screen reader: a draft slot with nothing in it (%d is 1 to 6)
msgid "Draft %d, empty"
msgstr "Dréacht %d, folamh"

#. Screen reader: a draft slot with a level not yet beaten
msgid "Draft %d"
msgstr "Dréacht %d"

#. Screen reader: a draft its maker has beaten, ready to share
msgid "Draft %d, signed"
msgstr "Dréacht %d, sínithe"

#. Screen reader: a level a friend sent (%d counts them)
msgid "Received level %d"
msgstr "Leibhéal faighte %d"

#. Screen reader: the text box for a level code
msgid "Level code"
msgstr "Cód leibhéil"

#. Screen reader: the QR code picture on the share sheet
msgid "QR code of the level"
msgstr "Cód QR an leibhéil"

#. Editor palette: a tile that falls away once MapMan steps off it
msgid "CRUMBLE TILE"
msgstr "TÍL A THITEANN"

#. Editor button: wipe the whole grid (UNDO brings it back)
msgid "CLEAR"
msgstr "GLAN"

#. Drafting table item and sheet title: point the phone's camera at a friend's level QR code to play it
msgid "SCAN A QR CODE"
msgstr "SCANÁIL CÓD QR"

#. Scan sheet: instruction at the top. The share sheet is the screen in a friend's game that shows their level's QR code
msgid "POINT THE CAMERA AT THE QR CODE ON A FRIEND'S SHARE SHEET"
msgstr "DÍRIGH AN CEAMARA AR AN gCÓD QR AR BHILEOG ROINNTE CARA"

#. Scan sheet: status while the camera is on and no code has been read yet
msgid "LOOKING FOR A QR CODE…"
msgstr "AG LORG CÓD QR…"

#. Scan sheet: status when the device has no camera the game can use
msgid "NO CAMERA FOUND"
msgstr "NÍOR AIMSÍODH CEAMARA"

#. Scan sheet: status when the player refused the camera permission; they can allow it in the phone's settings
msgid "MAPMAN ISN'T ALLOWED TO USE THE CAMERA. ALLOW IT IN THE PHONE'S SETTINGS"
msgstr "NÍL CEAD AG MAPMAN AN CEAMARA A ÚSÁID. CEADAIGH É I SOCRUITHE AN FHÓIN"

#. Scan sheet: status when the camera read a QR code that holds something else
msgid "THAT QR CODE ISN'T A MAPMAN LEVEL"
msgstr "NÍ LEIBHÉAL MAPMAN AN CÓD QR SIN"

#. Scan sheet item: go to the screen for typing a level code instead of scanning
msgid "TYPE A CODE INSTEAD"
msgstr "CLÓSCRÍOBH CÓD"

#. Screen reader: the live picture from the camera on the scan sheet
msgid "Camera view"
msgstr "Radharc an cheamara"

#. Editor palette: an ice tile; MapMan slides across it until something stops him
msgid "ICE"
msgstr "OIGHEAR"

#. Editor palette: spikes that rise and fall on a beat; touching them while up costs a life
msgid "SPIKES"
msgstr "SPÍCEANNA"

#. Editor palette: spikes that rise and fall half a beat after the others, so rows of them make a wave
msgid "OFF-BEAT SPIKES"
msgstr "SPÍCEANNA AR CHÚLBHUILLE"

#. Options row and sheet title: how MapMan is steered (tilting the device or the on-screen touch stick)
msgid "CONTROLS"
msgstr "RIALUITHE"

#. Options value: MapMan is steered by tilting the device
msgid "TILT"
msgstr "CLAONADH"

#. Options value: MapMan is steered with the on-screen touch stick
msgid "TOUCH"
msgstr "TADHALL"

#. Controls row: steer with an on-screen stick that appears where a finger touches and drags
msgid "DRAG TO MOVE"
msgstr "TARRAING LE BOGADH"

#. Controls row: how little tilt moves MapMan
msgid "TILT SENSITIVITY"
msgstr "ÍOGAIRE"

#. Tilt sensitivity value: needs more tilt
msgid "LOW"
msgstr "ÍSEAL"

#. Tilt sensitivity value: the default
msgid "NORMAL"
msgstr "GNÁTH"

#. Tilt sensitivity value: needs less tilt
msgid "HIGH"
msgstr "ARD"

#. Pause sheet small print when steering with the touch stick
msgid "NOTE: DRAG TO MOVE · TAP THE SHEET TO PAUSE"
msgstr "NÓTA: TARRAING LE BOGADH · TAPÁIL AN BHILEOG LE SOS A GHLACADH"

#. Tutorial lesson 1 when steering with the touch stick (two lines, up to about 85 characters a line)
msgid ""
"Touch and drag anywhere to move around the map and head for the exit tile.\n"
"Drag past the dashed ring to walk, past the solid ring to run."
msgstr ""
"Tadhaill agus tarraing áit ar bith le bogadh agus déan ar an tíl amach.\n"
"Thar an bhfáinne briste siúl, thar an bhfáinne iomlán rith."

#. Tutorial lesson 11 when steering with the touch stick
msgid "Tap the screen during play to pause. Only a quick tap pauses: a touch that drags moves MapMan."
msgstr "Tapáil an scáileán le linn imeartha chun sos a ghlacadh. Ní ghlacann ach tapáil ghasta sos: má tharraingíonn tú, bogann MapMan."

#. Controls sheet value on the greyed-out tilt rows while steering by touch: the setting only applies to tilt
msgid "TILT ONLY"
msgstr "CLAONADH AMHÁIN"

#. First run, before the tutorial: small print on the sheet asking whether to steer by tilting the device or dragging a finger (rows: TILT TO MOVE, DRAG TO MOVE)
msgid "HOW DO YOU WANT TO STEER? YOU CAN CHANGE IT IN OPTIONS"
msgstr "CONAS IS MIAN LEAT STIÚRADH? ATHRAIGH É I ROGHANNA"

#. First run, after two tutorial lessons: small print on the sheet asking once whether the chosen steering suits the player
msgid "HOW IS THE STEERING GOING?"
msgstr "CONAS ATÁ AN STIÚRADH AG DUL?"

#. First run steering check: row that keeps the current steering; %s is TILT TO MOVE or DRAG TO MOVE
msgid "KEEP %s"
msgstr "COINNIGH: %s"

#. First run steering check: row that switches to the other steering; %s is TILT TO MOVE or DRAG TO MOVE
msgid "TRY %s"
msgstr "TRIAIL: %s"

#. Level card: this level was drawn on this phone
msgid "MADE BY YOU"
msgstr "DÉANTA AGAT"

#. Level card: this level came from someone else's code
msgid "FROM A FRIEND"
msgstr "Ó CHARA"

#. Level card title: a level a friend sent (%d is its number on the drafting table, 1 to 12)
msgid "RECEIVED LEVEL %d"
msgstr "LEIBHÉAL A FUARTHAS %d"

#. Level card figure label: how many tries the level has had
msgid "PLAYED"
msgstr "IMRITHE"

#. Level card figure label: how many times it was won
msgid "CLEARED"
msgstr "CRÍOCHNAITHE"

#. Level card figure label: the best time
msgid "BEST"
msgstr "BUAIC"

#. Level card figure: the best time, as seconds left on the clock (%d)
msgid "%ds LEFT"
msgstr "%ds FÁGTHA"

#. Level card button: play this level
msgid "PLAY"
msgstr "IMIR"

#. Level card button: open the draft in the editor
msgid "EDIT"
msgstr "CUIR IN EAGAR"

#. Level card button: copy a friend's level into an empty draft, to change it
msgid "REMIX"
msgstr "ATHMHEASC"

#. Level card button, and the button that confirms it: remove the level for good
msgid "DELETE"
msgstr "SCRIOS"

#. Level card button: give the level a name that only this player sees
msgid "RENAME"
msgstr "ATHAINMNIGH"

#. Replay heading for a drafting table level: its name (%s)
msgid "REPLAY — %s"
msgstr "ATHIMRT — %s"

#. Delete question button: don't delete
msgid "KEEP IT"
msgstr "COINNIGH É"

#. Share sheet item: back to the level's card
msgid "BACK TO THE LEVEL"
msgstr "AR AIS GO DTÍ AN LEIBHÉAL"

#. Delete question (%d is the draft's number, 1 to 6)
msgid "DELETE DRAFT %d?"
msgstr "DRÉACHT %d A SCRIOSADH?"

#. Delete question for a level a friend sent (%d is its number, 1 to 12)
msgid "DELETE RECEIVED LEVEL %d?"
msgstr "LEIBHÉAL %d A SCRIOSADH?"

#. Delete question note, under the question; wraps onto two lines
msgid "ITS NAME, BEST TIME AND GHOST GO WITH IT. THIS CAN'T BE UNDONE"
msgstr "IMEOIDH A AINM, A BHUAIC AGUS A THAIBHSE LEIS. NÍ FÉIDIR É A CHEALÚ"

#. Rename sheet: the name stays on this phone and is never sent with the level's code
msgid "NAME THIS LEVEL · ONLY YOU SEE IT"
msgstr "AINMNIGH AN LEIBHÉAL · TUSA AMHÁIN A FHEICEANN É"

#. Rename sheet button
msgid "SAVE THE NAME"
msgstr "SÁBHÁIL AN T-AINM"

#. Level card note when no draft is empty, so REMIX can't copy the level
msgid "ALL 6 DRAFTS ARE IN USE: DELETE ONE TO REMIX"
msgstr "TÁ NA 6 DHRÉACHT IN ÚSÁID: SCRIOS CEANN"

#. Level card note after a win with more time left than ever before (%d seconds)
msgid "CLEARED WITH %ds LEFT · NEW BEST"
msgstr "CRÍOCHNAITHE, %ds FÁGTHA · BUAIC NUA"

#. Screen reader: the text box for a level's name
msgid "Level name"
msgstr "Ainm an leibhéil"

#. Screen reader: the picture of the level on its card
msgid "The level's map"
msgstr "Léarscáil an leibhéil"

#. Toolbox: first branch of tools, the ones the player uses by tapping
msgid "YOUR HAND"
msgstr "DO LÁMH"

#. Toolbox: line under the YOUR HAND branch
msgid "you help him"
msgstr "cabhraíonn tú leis"

#. Toolbox: second branch, MapMan's own moves and saves
msgid "HIS FEET"
msgstr "A CHOSA"

#. Toolbox: line under the HIS FEET branch
msgid "he gets moves"
msgstr "faigheann sé céimeanna"

#. Toolbox: third branch, tools that change the level's countdown
msgid "THE CLOCK"
msgstr "AN CLOG"

#. Toolbox: line under THE CLOCK branch
msgid "time bends"
msgstr "lúbann an t-am"

#. Toolbox tool: shows the hidden tiles for a moment, like paper on a light table
msgid "LIGHT TABLE"
msgstr "BORD SOLAIS"

#. Toolbox tool: pins spikes or a crumble tile so it stays as it is
msgid "PUSH PIN"
msgstr "TACÓID"

#. Toolbox tool: MapMan hops over the next tile
msgid "HOP"
msgstr "LÉIM"

#. Toolbox tool: out of lives, MapMan gets back up on the same sheet (a drawing's second draft); also floats over the field when it happens
msgid "SECOND DRAFT"
msgstr "2Ú DRÉACHT"

#. Toolbox tool: everything at half speed for a few seconds
msgid "SLOW-MO"
msgstr "MALLGHLUAISNE"

#. Toolbox tool: the clock waits a few seconds at the start of a try; also the HUD's note while it does
msgid "FIRST LOOK"
msgstr "CÉAD AMHARC"

#. Toolbox tool: the countdown stops for a few seconds while MapMan keeps walking
msgid "STOP CLOCK"
msgstr "STAD AN CHLOIG"

#. Floats over the field when the Hard Hat tool saves MapMan from a skull or spikes
msgid "HARD HAT!"
msgstr "CLOGAD!"

#. Toolbox: what the Eraser does (card, wraps over 3-4 short lines)
msgid "Tap a skull to rub it out, even one you can't see."
msgstr "Tapáil cloigeann chun é a scriosadh, fiú ceann nach bhfeiceann tú."

#. Toolbox: what the Light Table does
msgid "The hidden tiles show through the paper for a moment."
msgstr "Feictear na tíleanna folaithe tríd an bpáipéar ar feadh nóiméid."

#. Toolbox: what the Push Pin does
msgid "Tap spikes or a crumble tile to pin it: it stays put."
msgstr "Tapáil spící nó tíl bhriosc chun í a phionnáil: fanann sí mar atá."

#. Toolbox: what Hop does
msgid "He hops over the next tile the way he's facing."
msgstr "Léimeann sé thar an gcéad tíl eile sa treo a bhfuil sé ag féachaint."

#. Toolbox: what the Hard Hat does
msgid "The first skull on a sheet doesn't get him."
msgstr "Ní bhfaigheann an chéad chloigeann ar bhileog é."

#. Toolbox: what Second Draft does
msgid "Out of lives, he gets back up on the same sheet."
msgstr "Gan aon bheatha fágtha, éiríonn sé arís ar an mbileog chéanna."

#. Toolbox: what Slow-mo does
msgid "Everything at half speed for a few seconds, music too."
msgstr "Gach rud ar leathluas ar feadh cúpla soicind, an ceol freisin."

#. Toolbox: what First Look does
msgid "The clock waits while you take in the sheet."
msgstr "Fanann an clog fad a bhreathnaíonn tú ar an mbileog."

#. Toolbox: what Stop Clock does
msgid "The countdown stops while he keeps walking."
msgstr "Stadann an comhaireamh síos fad a shiúlann sé ar aghaidh."

#. Toolbox tier line: the Eraser's recharge time (%s seconds)
msgid "RECHARGES IN %s S"
msgstr "ATHLUCHTÚ I %s S"

#. Toolbox tier line: how long the Light Table or First Look shows (%s seconds)
msgid "%s S LOOK"
msgstr "AMHARC %s S"

#. Toolbox tier line: how long the Push Pin holds (%s seconds)
msgid "PINNED %s S"
msgstr "PIONNÁILTE %s S"

#. Toolbox tier line: Hop clears one tile, recharges in %s seconds
msgid "1 TILE, %s S RECHARGE"
msgstr "1 TÍL, ATHLUCHTÚ %s S"

#. Toolbox tier line: Hop clears two tiles, recharges in %s seconds
msgid "2 TILES, %s S RECHARGE"
msgstr "2 THÍL, ATHLUCHTÚ %s S"

#. Toolbox tier line: Second Draft puts MapMan back up with %s seconds on the clock
msgid "BACK UP WITH %s S"
msgstr "AR AIS LE %s S"

#. Toolbox tier line: Second Draft works twice a game, with %s seconds
msgid "TWICE A GAME, %s S"
msgstr "2× SA CHLUICHE, %s S"

#. Toolbox tier line: how long Slow-mo lasts
msgid "%s S AT HALF SPEED"
msgstr "%s S AR LEATHLUAS"

#. Toolbox tier line: how long Stop Clock holds the countdown
msgid "CLOCK STOPS %s S"
msgstr "CLOG STOPTHA %s S"

#. Title of sheet 001-T, the tree of tools bought with stars; also the main menu row, pause row and level-clear button that open it
msgid "TOOLBOX"
msgstr "UIRLISÍ"

#. Toolbox: label under the star count the player has to spend
msgid "IN THE BANK"
msgstr "SA BHANC"

#. Toolbox: tag on a tool carried into levels
msgid "ON BELT"
msgstr "AR CHRIOS"

#. Toolbox: tag on a tool bought but not on the belt
msgid "OWNED"
msgstr "AGAT"

#. Toolbox card: how often a tool works (it recharges after each use)
msgid "RECHARGES"
msgstr "ATHLUCHTAÍONN"

#. Toolbox card: the tool works once per try at a level
msgid "ONCE A TRY"
msgstr "UAIR SA TRIAIL"

#. Toolbox card: the tool works once per level
msgid "ONCE A SHEET"
msgstr "UAIR SA BHILEOG"

#. Toolbox card: the tool works once per game from the start
msgid "ONCE A GAME"
msgstr "UAIR SA CHLUICHE"

#. Toolbox card: the tool works at the start of every try
msgid "EVERY TRY"
msgstr "GACH TRIAIL"

#. Toolbox card button: buy tier %s (I, II or III) for %d stars
msgid "BUY %s  ★ %d"
msgstr "FAIGH %s  ★ %d"

#. Toolbox card: all three tiers of the tool are bought
msgid "EVERY TIER OWNED"
msgstr "GACH LEIBHÉAL AGAT"

#. Toolbox card: stars still needed for the next tier
msgid "★ %d MORE TO GO"
msgstr "★ %d EILE"

#. Toolbox card: the tool above (%s, its name) must be bought before this one
msgid "BUY %s FIRST"
msgstr "CEANNAIGH %s AR DTÚS"

#. Toolbox card button: carry the tool into levels
msgid "PUT ON BELT"
msgstr "CUIR AR CHRIOS"

#. Toolbox card button: stop carrying the tool
msgid "TAKE OFF BELT"
msgstr "BAIN DEN CHRIOS"

#. Toolbox card: no free belt slot for this tool
msgid "BELT FULL"
msgstr "CRIOS LÁN"

#. Toolbox: label of the strip of belt slots (the tools carried into levels)
msgid "BELT"
msgstr "CRIOS"

#. Toolbox: the third belt slot opens at level %d
msgid "SHEET %d"
msgstr "BILEOG %d"

#. Toolbox: the reset that takes back every star spent (bought once)
msgid "FRESH SHEET"
msgstr "BILEOG NUA"

#. Toolbox: Fresh Sheet button before it is bought
msgid "BUY FOR ★ %d"
msgstr "CEANNAIGH ★ %d"

#. Toolbox: Fresh Sheet button once bought, %s is the stars that come back
msgid "TAKE BACK ★ %s"
msgstr "FAIGH ★ %s AR AIS"

#. Toolbox: Fresh Sheet has nothing to take back
msgid "NOTHING SPENT"
msgstr "FAIC CAITE"

#. Toolbox: Fresh Sheet can't be used while a level is paused
msgid "BETWEEN SHEETS ONLY"
msgstr "IDIR BHILEOGA AMHÁIN"

#. Toolbox: button back to the level it was opened from (%s is its number); keep <
msgid "<  SHEET %s"
msgstr "<  BILEOG %s"

#. Screen reader name of a tool's node in the toolbox (%s its name)
msgid "%s, tier %d of 3"
msgstr "%s, leibhéal %d as 3"

#. Screen reader name of a tool not bought yet
msgid "%s, not owned"
msgstr "%s, gan cheannach"

#. Screen reader name of a tool whose tool above isn't bought
msgid "%s, locked"
msgstr "%s, faoi ghlas"

#. Screen reader name of the toolbox's star count
msgid "%d stars in the bank"
msgstr "%d réalta sa bhanc"

#. Level clear small print: stars the level paid into the bank, and the bank's total
msgid "★ %d INTO THE STAR BANK · NOW ★ %d"
msgstr "★ %d SA BHANC RÉALTAÍ · ANOIS ★ %d"

#. Toolbox: stars spent so far of the whole tree's price (small print under the bank)
msgid "★ %s / ★ %s SPENT"
msgstr "★ %s / ★ %s CAITE"

#. Toolbox tier line: the Hard Hat saves from a skull once a sheet
msgid "SKULL, ONCE A SHEET"
msgstr "CLOIGEANN, UAIR SA BHILEOG"

#. Toolbox tier line: the Hard Hat saves from a skull or spikes once a sheet
msgid "SKULL OR SPIKES, ONCE"
msgstr "CLOIGEANN NÓ SPÍCÍ, 1×"

#. Level card title for a main game level opened from practice (%d is 1 to 100)
msgid "LEVEL %d"
msgstr "LEIBHÉAL %d"

#. Level card figure label: stars collected of the stars on the level, shown like ★ 2/3
msgid "STARS"
msgstr "RÉALTAÍ"

#. Level card button: play back the level's best run (its ghost)
msgid "WATCH BEST RUN"
msgstr "FÉACH AN BHUAIC"

#. Heading while a level's best run plays back (%d is the level)
msgid "BEST RUN — LEVEL %d"
msgstr "BUAIC — LEIBHÉAL %d"

#. Level card: the line above the map, and the way back to the practice sheets
msgid "PRACTICE"
msgstr "CLEACHTADH"

#. Level card note: tiles that start hidden aren't drawn on the map until the level has been beaten
msgid "CLEAR IT TO SEE ITS HIDDEN TILES"
msgstr "CRÍOCHNAIGH É LE TÍLEANNA I BHFOLACH A FHEICEÁIL"
