msgid ""
msgstr ""
"Project-Id-Version: MapMan\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ko\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#. Header of every menu sheet: the game name, the sheet number (%s, e.g. 001 or P-02), the sheet title (%s). Keep MAPMAN. Blueprint drawing-sheet vocabulary throughout.
msgid "MAPMAN  —  SHEET %s  —  %s"
msgstr "MAPMAN  —  도면 %s  —  %s"

#. Title block, three lines: revision (%s is a version like 1.3.0), scale, sheet number (%s). Each line at most 11 characters.
msgid ""
"REV %s\n"
"SCALE 1:3\n"
"SHEET %s"
msgstr ""
"개정 %s\n"
"축척 1:3\n"
"도번 %s"

#. Column heading over a parts list
msgid "ITEM"
msgstr "항목"

#. Column heading over a parts list
msgid "DESCRIPTION"
msgstr "명칭"

#. Column heading on the options sheet
msgid "PARAMETER"
msgstr "매개변수"

#. Column heading
msgid "VALUE"
msgstr "값"

#. Column heading: quantity
msgid "QTY"
msgstr "수량"

#. Row that goes back to the main menu (sheet 001). Keep the '<  ' prefix.
msgid "<  RETURN TO SHEET 001"
msgstr "<  도면 001로 돌아가기"

#. Sheet title and a row text
msgid "MAIN MENU"
msgstr "메인 메뉴"

#. Label of the total row on a score table
msgid "TOTAL"
msgstr "합계"

#. Small print prefix; %s is a sentence
msgid "NOTE: %s"
msgstr "주: %s"

#. Sheet title
msgid "FIRST RUN"
msgstr "첫 실행"

#. Sheet title and a row text
msgid "OPTIONS"
msgstr "설정"

#. Sheet title
msgid "PAUSED"
msgstr "일시정지"

#. Sheet title (confirm quitting)
msgid "CONFIRM"
msgstr "확인"

#. Sheet title when a life is lost; defect as on an inspection report
msgid "LEVEL %d — DEFECT"
msgstr "레벨 %d — 결함"

#. Sheet title
msgid "GAME OVER"
msgstr "게임 오버"

#. Sheet title: pick a checkpoint to restart from
msgid "CHECKPOINTS"
msgstr "체크포인트"

#. Sheet title: practice mode, a range of levels
msgid "PRACTICE — LEVELS %d–%d"
msgstr "연습 — 레벨 %d–%d"

#. Sheet title after clearing a level: the score is 'inspected'
msgid "LEVEL %d — INSPECTION"
msgstr "레벨 %d — 검사"

#. Sheet title after clearing a checkpoint level
msgid "LEVEL %d — CHECKPOINT"
msgstr "레벨 %d — 체크포인트"

#. Sheet title after finishing the game
msgid "CONGRATULATIONS"
msgstr "축하합니다"

#. Sheet title: final score table
msgid "FINAL INSPECTION"
msgstr "최종 검사"

#. Options row and the language sheet's title
msgid "LANGUAGE"
msgstr "언어"

#. Options value and a box on the language sheet: follow the phone's language; the value column holds 17 characters
msgid "PHONE'S LANGUAGE"
msgstr "휴대폰 언어"

#. Main menu row
msgid "PLAY FROM START"
msgstr "처음부터 플레이"

#. Main menu row
msgid "CONTINUE FROM CHECKPOINT"
msgstr "체크포인트에서 계속"

#. Main menu row
msgid "PRACTICE A LEVEL"
msgstr "레벨 연습"

#. Main menu row
msgid "TUTORIAL"
msgstr "튜토리얼"

#. Main menu small print
msgid "BEST SCORE %d"
msgstr "최고 점수 %d"

#. Main menu small print, n is 100
msgid "%d LEVEL"
msgid_plural "%d LEVELS"
msgstr[0] "레벨 %d개"

#. First run sheet, small print
msgid "NEW TO MAPMAN? THE TUTORIAL TAKES A MINUTE"
msgstr "MAPMAN이 처음이신가요? 튜토리얼은 1분이면 끝납니다"

#. First run row
msgid "TAKE THE TUTORIAL"
msgstr "튜토리얼 시작"

#. First run row
msgid "SKIP TO THE GAME"
msgstr "건너뛰고 게임으로"

#. Options row (a toggle)
msgid "MUSIC"
msgstr "음악"

#. Options row (a toggle)
msgid "SOUND EFFECTS"
msgstr "효과음"

#. Options row (a toggle)
msgid "VIBRATION"
msgstr "진동"

#. Options row: turns decorative animation off
msgid "REDUCE MOTION"
msgstr "동작 줄이기"

#. Options row: shows or hides the tilt gauge, a small dial in the corner of the playing field that shows how far the device is tilted
msgid "TILT GAUGE"
msgstr "기울기 게이지"

#. Pause sheet status line; work suspended as on a drawing office note
msgid "WORK SUSPENDED AT LEVEL %d"
msgstr "레벨 %d에서 작업 중단"

#. Appended to the status line: minutes:seconds left on the clock. Keep the leading ' · ' and T-%d:%02d.
msgid " · T-%d:%02d REMAINING"
msgstr " · T-%d:%02d 남음"

#. Pause sheet status line in the tutorial
msgid "WORK SUSPENDED · TUTORIAL"
msgstr "작업 중단 · 튜토리얼"

#. Pause sheet status line on the final map
msgid "WORK SUSPENDED · FINAL SHEET"
msgstr "작업 중단 · 최종 도면"

#. Pause row
msgid "RESUME"
msgstr "재개"

#. Pause row
msgid "END GAME"
msgstr "게임 종료"

#. Pause row
msgid "END TUTORIAL"
msgstr "튜토리얼 종료"

#. Pause sheet small print
msgid "NOTE: TILT TO MOVE · TAP THE SHEET TO PAUSE"
msgstr "주: 기울여서 이동 · 도면을 탭하면 일시정지"

#. Rubber stamp on the pause sheet; one or two short words
msgid "ON HOLD"
msgstr "보류"

#. Confirm sheet, two lines
msgid ""
"END THIS GAME?\n"
"PROGRESS SINCE THE LAST CHECKPOINT IS LOST"
msgstr ""
"게임을 종료할까요?\n"
"마지막 체크포인트 이후 진행 상황이 사라집니다"

#. Confirm row
msgid "NO, KEEP PLAYING"
msgstr "아니요, 계속하기"

#. Confirm row
msgid "YES, END THE GAME"
msgstr "예, 게임 종료"

#. Lost-life sheet, cause line
msgid "DEFECT: STEPPED ON A DEATH TILE"
msgstr "결함: 독 타일을 밟음"

#. Lost-life sheet, cause line
msgid "DEFECT: OUT OF TIME"
msgstr "결함: 시간 초과"

#. Lost-life sheet label, discs follow
msgid "LIVES REMAINING"
msgstr "남은 목숨"

#. Lost-life row
msgid "TRY AGAIN FROM THE START TILE"
msgstr "시작 타일에서 다시 도전"

#. Lost-life small print
msgid "NOTE: ROUTE AROUND THE DEATH TILES"
msgstr "주: 독 타일을 우회할 것"

#. Lost-life small print after a timeout: 20 seconds per level
msgid "NOTE: T-0:20 PER SHEET · TAKE THE SHORT WAY"
msgstr "주: 도면당 T-0:20 · 지름길로 갈 것"

#. Lost-life small print once the assists are on: hidden death tiles get a dashed outline on the next tries
msgid "NOTE: HIDDEN DEATH TILES ARE MARKED FROM NOW ON"
msgstr "주: 숨겨진 독 타일에 표시가 붙음"

#. Lost-life small print: a dashed line shows the safe route for a moment at the start of every try
msgid "NOTE: THE SAFE ROUTE IS SKETCHED AS EACH TRY STARTS"
msgstr "주: 매 시도 시작 시 안전 경로를 스케치함"

#. Lost-life row, offered after many lives lost on one level: go on to the next level without points
msgid "SKIP THIS SHEET"
msgstr "이 도면 건너뛰기"

#. Rubber stamp on the lost-life sheet
msgid "REWORK"
msgstr "재작업"

#. Game over label
msgid "FINAL SCORE"
msgstr "최종 점수"

#. Game over small print
msgid "PREVIOUS BEST  %d"
msgstr "이전 최고 점수  %d"

#. Game over row
msgid "RESTART FROM A CHECKPOINT"
msgstr "체크포인트에서 다시 시작"

#. Rubber stamp: a new high score
msgid "NEW BEST"
msgstr "신기록"

#. Checkpoints sheet heading
msgid "RESTART FROM A SAVED CHECKPOINT"
msgstr "저장된 체크포인트에서 다시 시작"

#. Checkpoint cell: reached and saved
msgid "SAVED"
msgstr "저장됨"

#. Cell: not reached yet
msgid "LOCKED"
msgstr "잠김"

#. Practice grid column pair heading: level ('part' of the drawing) and best result. Keep the three spaces.
msgid "PART   BEST"
msgstr "부품   최고"

#. Level cell label, L for level; keep short
msgid "L%02d"
msgstr "L%02d"

#. Best in a practice cell: seconds left, star count. Keep ★.
msgid "%ds ★%d"
msgstr "%d초 ★%d"

#. Seconds, short unit
msgid "%ds"
msgstr "%d초"

#. Practice caption: page x of y
msgid "SHEET %d OF %d"
msgstr "도면 %d / %d"

#. Practice caption: levels unlocked
msgid "%d PART RELEASED"
msgid_plural "%d PARTS RELEASED"
msgstr[0] "부품 %d개 해금"

#. Score table row
msgid "LEVEL BONUS"
msgstr "레벨 보너스"

#. Score table row
msgid "TIME BONUS"
msgstr "시간 보너스"

#. Score table row
msgid "STARS COLLECTED"
msgstr "획득한 별"

#. Seconds with a space, quantity column
msgid "%d s"
msgstr "%d초"

#. Level clear small print; next level number
msgid "TAP TO CONTINUE TO SHEET %03d"
msgstr "탭하여 도면 %03d 시작"

#. Level 100 clear small print
msgid "TAP TO CONTINUE TO THE FINAL SHEET"
msgstr "탭하여 최종 도면 시작"

#. Level clear: what NEXT does, for screen readers
msgid "NEXT LEVEL"
msgstr "다음 레벨"

#. Level clear button, first of three side by side: on to the next level
msgid "NEXT"
msgstr "다음"

#. Level clear button, last of three side by side: back to the main menu (asks first)
msgid "MENU"
msgstr "메뉴"

#. Checkpoint level clear small print
msgid "CHECKPOINT SAVED · RESTART FROM HERE ANY TIME"
msgstr "체크포인트 저장됨 · 언제든 여기서 다시 시작"

#. Rubber stamp on a cleared level
msgid "PASSED"
msgstr "합격"

#. Last row of the wardrobe when opened from a level clear: back to it; keep <  and the number
msgid "<  RETURN TO SHEET %03d"
msgstr "<  도면 %03d로 돌아가기"

#. Congratulations small print
msgid "ALL 100 SHEETS APPROVED · EVERY LEVEL IS OPEN IN PRACTICE"
msgstr "도면 100장 모두 승인 · 연습에서 모든 레벨 열림"

#. Final score table row
msgid "SCORE AT LEVEL 100"
msgstr "레벨 100 점수"

#. Final score table row
msgid "COMPLETION BONUS"
msgstr "클리어 보너스"

#. Final score table row: 50 points per life left
msgid "LIVES REMAINING ×50"
msgstr "남은 목숨 ×50"

#. Final inspection small print
msgid "ALL 100 SHEETS APPROVED · THANK YOU FOR PLAYING"
msgstr "도면 100장 모두 승인 · 플레이해 주셔서 감사합니다"

#. Second note on the game-complete sheet, when finishing added Revision B lessons to the tutorial
msgid "NOTE: THE TUTORIAL HAS NEW LESSONS"
msgstr "참고: 튜토리얼에 새 레슨이 추가됨"

#. Rubber stamp on the final sheet
msgid "APPROVED"
msgstr "승인"

#. HUD header: level number / level count
msgid "SHEET %03d / %d"
msgstr "도면 %03d / %d"

#. HUD header in the tutorial
msgid "TUTORIAL %d / %d"
msgstr "튜토리얼 %d / %d"

#. HUD note at level start
msgid "GO!"
msgstr "출발!"

#. HUD note, three seconds left
msgid "HURRY UP!"
msgstr "서둘러!"

#. HUD note while the level loads
msgid "GET READY..."
msgstr "준비…"

#. Controls row: steer by tilting the device (also a HUD note on level 1)
msgid "TILT TO MOVE"
msgstr "기울여서 이동"

#. HUD note: a star was collected
msgid "BONUS POINTS"
msgstr "보너스 점수"

#. HUD note
msgid "EXTRA TIME"
msgstr "시간 추가"

#. HUD note
msgid "TIME LOST"
msgstr "시간 감소"

#. HUD note
msgid "EXTRA LIFE"
msgstr "목숨 추가"

#. HUD note: tilt directions are mirrored
msgid "CONTROLS REVERSED"
msgstr "조작 반전"

#. HUD note
msgid "TILES HIDDEN"
msgstr "타일 숨김"

#. HUD note: the hidden tiles are back
msgid "TILES UNHIDDEN"
msgstr "타일 다시 표시"

#. HUD note while MapMan is invisible
msgid "SEE YOU AGAIN IN %d MOVE"
msgid_plural "SEE YOU AGAIN IN %d MOVES"
msgstr[0] "%d칸 뒤에 다시 만나요"

#. HUD note, two lines, both effects at once
msgid ""
"CONTROLS REVERSED &\n"
"SEE YOU AGAIN IN %d MOVE"
msgid_plural ""
"CONTROLS REVERSED &\n"
"SEE YOU AGAIN IN %d MOVES"
msgstr[0] ""
"조작 반전 &\n"
"%d칸 뒤에 다시 만나요"

#. HUD note, two lines
msgid ""
"CONTROLS REVERSED &\n"
"TILES HIDDEN"
msgstr ""
"조작 반전 &\n"
"타일 숨김"

#. HUD note: caught in a cobweb; shake the phone
msgid "STUCK, SHAKE TO RELEASE"
msgstr "걸림, 기기를 흔들어 해제"

#. HUD note on a desktop without sensors
msgid "STUCK, TAP TO RELEASE"
msgstr "걸림, 탭하여 해제"

#. HUD note, both effects
msgid "STUCK & CONTROLS REVERSED. SHAKE TO RELEASE."
msgstr "걸림 & 조작 반전. 기기를 흔들어 해제."

#. HUD note, both effects, desktop
msgid "STUCK & CONTROLS REVERSED. TAP TO RELEASE."
msgstr "걸림 & 조작 반전. 탭하여 해제."

#. Practice result caption: seconds left on the clock
msgid "LEVEL %d: %ds LEFT"
msgstr "레벨 %d: %d초 남음"

#. Practice result caption
msgid "LEVEL %d: %ds LEFT, NEW BEST!"
msgstr "레벨 %d: %d초 남음, 신기록!"

#. Floating note on an extra-time tile: five seconds
msgid "+5 S"
msgstr "+5초"

#. Floating note on a time-loss tile; keep the minus sign U+2212
msgid "−5 S"
msgstr "−5초"

#. Screen reader name of the practice page arrow
msgid "Previous page"
msgstr "이전 페이지"

#. Screen reader name
msgid "Next page"
msgstr "다음 페이지"

#. Screen reader name of a practice cell
msgid "Level %d"
msgstr "레벨 %d"

#. Screen reader name
msgid "Level %d, locked"
msgstr "레벨 %d, 잠김"

#. Screen reader name of a checkpoint cell
msgid "Restart after level %d"
msgstr "레벨 %d 이후부터 다시 시작"

#. Screen reader name
msgid "Checkpoint at level %d, not reached"
msgstr "레벨 %d 체크포인트, 미도달"

#. Screen reader state of a toggle
msgid "on"
msgstr "켜짐"

#. Screen reader state of a toggle
msgid "off"
msgstr "꺼짐"

#. Screen reader
msgid "%d life remaining"
msgid_plural "%d lives remaining"
msgstr[0] "남은 목숨 %d개"

#. Screen reader name of the HUD level label
msgid "Level"
msgstr "레벨"

#. Screen reader name
msgid "Score"
msgstr "점수"

#. Screen reader name
msgid "Lives"
msgstr "목숨"

#. Screen reader name
msgid "Time left"
msgstr "남은 시간"

#. Tutorial lesson 1, shown in the bottom bar (two lines, up to about 85 characters a line)
msgid ""
"Tilt your device to move around the map and head for the exit tile.\n"
"The gauge in the corner shows your tilt: dashed ring to walk, solid ring to run."
msgstr ""
"기기를 기울여 이동하고 출구 타일로 가세요.\n"
"구석의 게이지가 기울기를 보여 줍니다: 점선 원은 걷기, 실선 원은 달리기."

#. Tutorial lesson 2
msgid ""
"Stepping on this tile will reverse the controls.\n"
"Step on another and they go back to normal."
msgstr ""
"이 타일을 밟으면 조작이 반전됩니다.\n"
"하나 더 밟으면 원래대로 돌아옵니다."

#. Tutorial lesson 3
msgid ""
"Stepping on this tile will make Map Man disappear.\n"
"Don't worry, after a few moves he will show up again."
msgstr ""
"이 타일을 밟으면 Map Man이 사라집니다.\n"
"걱정 마세요, 몇 칸만 움직이면 다시 나타납니다."

#. Tutorial lesson 4
msgid ""
"Stepping on this tile will cause Map Man to get stuck.\n"
"Shake your device to free him and get moving again."
msgstr ""
"이 타일을 밟으면 Map Man이 꼼짝 못 하게 됩니다.\n"
"기기를 흔들어 풀어 주고 다시 움직이세요."

#. Tutorial lesson 5
msgid ""
"Watch out for bonus points,\n"
"although you may have to go out of your way to get them."
msgstr ""
"보너스 점수를 노려 보세요.\n"
"다만 얻으려면 길을 돌아가야 할 수도 있습니다."

#. Tutorial lesson 6
msgid ""
"Also keep an eye out for extra lives,\n"
"but take care as they will take you\n"
"even more off course than bonus points."
msgstr ""
"추가 목숨도 눈여겨보세요.\n"
"다만 보너스 점수보다\n"
"더 멀리 돌아가게 되니 조심하세요."

#. Tutorial lesson 7
msgid "Be careful of the poison tiles: if you step on them you will lose a life."
msgstr "독 타일을 조심하세요. 밟으면 목숨을 하나 잃습니다."

#. Tutorial lesson 8
msgid ""
"These tiles crumble away once you step off them.\n"
"There is no going back, so plan the way ahead."
msgstr ""
"이 타일은 떠나는 순간 무너집니다.\n"
"되돌아갈 수 없으니 앞길을 미리 계획하세요."

#. Tutorial lesson 9
msgid ""
"Spikes rise and fall on a beat, with a warning first.\n"
"Wait for them to drop, then cross before they rise again."
msgstr ""
"가시는 경고 뒤에 일정한 박자로 오르내립니다.\n"
"내려갈 때까지 기다렸다가 다시 오르기 전에 건너세요."

#. Tutorial lesson 9
msgid ""
"Ice sends you sliding until a plain tile or the edge stops you.\n"
"You can't steer on it, so line up before you set off."
msgstr ""
"얼음 위에서는 일반 타일이나 가장자리에 막힐 때까지 미끄러집니다.\n"
"도중에 방향을 바꿀 수 없으니 출발 전에 방향을 맞추세요."

#. Tutorial lesson 10
msgid "These tiles will give you extra time or cost you time. You will get bonus points for time left on the clock when you finish each level."
msgstr "이 타일들은 시간을 늘리거나 줄입니다. 각 레벨을 마칠 때 남은 시간만큼 보너스 점수를 받습니다."

#. Tutorial lesson 11
msgid "These tiles cause other tiles to disappear and reappear. When the tiles are hidden you can still step on them so remember where they are."
msgstr "이 타일들은 다른 타일을 사라지게 했다가 다시 나타나게 합니다. 숨겨진 타일도 밟을 수 있으니 위치를 기억해 두세요."

#. Tutorial lesson 12
msgid "Every so often you'll come across a checkpoint. Each time you reach a checkpoint you can restart from there instead of going back to the beginning."
msgstr "가끔 체크포인트가 나타납니다. 체크포인트에 도달할 때마다 처음으로 돌아가는 대신 거기서 다시 시작할 수 있습니다."

#. Tutorial lesson 13
msgid "Tap the screen during play to pause. Holding your device a new way? Tap the corner gauge to set that as the new centre."
msgstr "플레이 중 화면을 탭하면 일시정지됩니다. 기기를 다르게 잡았다면 구석의 게이지를 탭해 그 자세를 새 중심으로 정하세요."

#. Tutorial lesson 14
msgid "You're all set, head for the exit to start the game. Have fun!"
msgstr "준비 완료! 출구로 가서 게임을 시작하세요. 즐겁게 플레이하세요!"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); plain MapMan, as he is
msgid "CLASSIC"
msgstr "클래식"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "PARTY HAT"
msgstr "파티 모자"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); bright red colour scheme, signal/pillar-box red
msgid "SIGNAL RED"
msgstr "시그널 레드"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); knitted winter hat with a pom-pom
msgid "BOBBLE HAT"
msgstr "방울모자"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); dark green with two white stripes, like a racing car
msgid "RACING GREEN"
msgstr "레이싱 그린"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); sunglasses
msgid "SHADES"
msgstr "선글라스"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); he is drawn as white lines, like an engineering drawing
msgid "BLUEPRINT"
msgstr "청사진"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "COWBOY"
msgstr "카우보이"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); a builder's safety helmet and hi-vis vest
msgid "HARD HAT"
msgstr "안전모"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "TOP HAT"
msgstr "실크해트"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); glowing neon outline
msgid "NEON"
msgstr "네온"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "DOCTOR"
msgstr "의사"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "PIRATE"
msgstr "해적"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); Halloween jack-o'-lantern head
msgid "PUMPKIN HEAD"
msgstr "호박 머리"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "SKELETON"
msgstr "해골"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); pith helmet, compass and a map
msgid "EXPLORER"
msgstr "탐험가"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "ASTRONAUT"
msgstr "우주비행사"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "ROBOT"
msgstr "로봇"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "SUPERHERO"
msgstr "슈퍼히어로"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin)
msgid "WIZARD"
msgstr "마법사"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); MapMan made of gold
msgid "SOLID GOLD"
msgstr "순금"

#. Wardrobe: name of a look MapMan can wear (one at a time, like a skin); a name: keep MAPWOMAN, as MAPMAN is kept
msgid "MAPWOMAN"
msgstr "MAPWOMAN"

#. Wardrobe: how rare a look is, as in collectible games
msgid "COMMON"
msgstr "일반"

#. Wardrobe: how rare a look is, as in collectible games
msgid "UNCOMMON"
msgstr "고급"

#. Wardrobe: how rare a look is, as in collectible games
msgid "RARE"
msgstr "희귀"

#. Wardrobe: how rare a look is, as in collectible games
msgid "EPIC"
msgstr "영웅"

#. Wardrobe: how rare a look is, as in collectible games
msgid "LEGENDARY"
msgstr "전설"

#. Wardrobe: how rare a look is, as in collectible games
msgid "SPECIAL"
msgstr "특별"

#. Main menu row and sheet title: where MapMan's looks are kept and chosen
msgid "WARDROBE"
msgstr "옷장"

#. Wardrobe note: looks released so far out of all of them, e.g. 10 OF 22 RELEASED; n is the first number
msgid "%d OF %d RELEASED"
msgid_plural "%d OF %d RELEASED"
msgstr[0] "%d/%d 해금"

#. Wardrobe note: tap a released look to put it on
msgid "TAP ONE TO WEAR IT"
msgstr "탭하여 착용"

#. Wardrobe cell: the level whose first clear releases this look, e.g. LV 35; very short
msgid "LV %d"
msgstr "Lv.%d"

#. Wardrobe cell for Classic: in the wardrobe from the start
msgid "START"
msgstr "기본"

#. Wardrobe cell for MapWoman: released by finishing the game
msgid "THE END"
msgstr "엔딩"

#. Rubber stamp: the look MapMan is wearing
msgid "WORN"
msgstr "착용 중"

#. Small tag on the main menu: a look not yet seen in the wardrobe
msgid "NEW"
msgstr "신규"

#. Wardrobe: when this look was released
msgid "RELEASED AT LEVEL %d"
msgstr "레벨 %d에서 해금"

#. Wardrobe: Classic's line
msgid "IN THE WARDROBE FROM THE START"
msgstr "처음부터 보유"

#. Wardrobe: MapWoman's line
msgid "RELEASED FOR FINISHING THE GAME"
msgstr "게임 클리어 시 해금"

#. Slip on the level-clear sheet: a look was just released
msgid "NEW IN THE WARDROBE"
msgstr "옷장에 새로 추가"

#. Button on the level-clear slip: wear the look just released, now
msgid "WEAR IT"
msgstr "입기"

#. Slip on the last sheet: MapWoman can now be worn; keep MAPWOMAN
msgid "MAPWOMAN JOINS THE WARDROBE"
msgstr "MAPWOMAN이 옷장에 합류"

#. Slip on the last sheet: wearing MapWoman, MapMan is the one waiting at the end; keep MAPMAN
msgid "PLAY AS HER: MAPMAN WAITS FOR YOU AT THE END"
msgstr "그녀로 플레이: 마지막에 MAPMAN이 기다려요"

#. Screen reader name of the main menu's wardrobe row
msgid "Wardrobe, %d of %d released"
msgstr "옷장, %d/%d 해금"

#. Screen reader: a look's name, and that MapMan wears it
msgid "%s, worn"
msgstr "%s, 착용 중"

#. Screen reader: a look not released yet
msgid "Locked, released at level %d"
msgstr "잠김, 레벨 %d에서 해금"

#. Screen reader: MapWoman before the game is finished
msgid "Locked, released for finishing the game"
msgstr "잠김, 게임 클리어 시 해금"

#. Level clear button, under MapMan: plays every try at the level back at once
msgid "WATCH REPLAY"
msgstr "리플레이 보기"

#. Heading of the replay of every try at a level (%d is the level number)
msgid "REPLAY — LEVEL %d"
msgstr "리플레이 — 레벨 %d"

#. Under the replay heading: how many tries at the level it shows
msgid "%d TRY"
msgid_plural "%d TRIES"
msgstr[0] "도전 %d번"

#. Options row: a faint MapMan replays your best run of the level beside you
msgid "BEST-RUN GHOST"
msgstr "최고 기록 고스트"

#. Title screen at launch, under the big MAPMAN title: tap anywhere to go on to the main menu. The phone version of an arcade PRESS START.
msgid "TAP TO START"
msgstr "탭하여 시작"

#. Title screen at launch: small corner note while the intro plays; tapping anywhere skips it to the title
msgid "SKIP"
msgstr "건너뛰기"

#. Main menu item and sheet title: where players draw their own levels, beat them and share them as a code. A drafting table is an architect's drawing desk.
msgid "DRAFTING TABLE"
msgstr "제도판"

#. Drafting table: heading over the six levels the player is drawing
msgid "YOUR DRAFTS"
msgstr "내 초안"

#. Drafting table: heading over levels other players sent as codes
msgid "RECEIVED LEVELS"
msgstr "받은 레벨"

#. Drafting table: shown while no level has been received yet
msgid "LEVELS FRIENDS SEND YOU APPEAR HERE"
msgstr "친구가 보낸 레벨이 여기에 표시됩니다"

#. Drafting table: a draft slot with nothing drawn in it (small cell)
msgid "EMPTY"
msgstr "비어 있음"

#. Drafting table: a draft slot with a level in it that its maker hasn't beaten yet (small cell)
msgid "DRAFT"
msgstr "초안"

#. Drafting table: a draft its maker has beaten, so it can be shared, like an approved drawing (small cell, also a stamp)
msgid "SIGNED"
msgstr "서명됨"

#. Drafting table item: type or paste a code a friend sent, to play their level
msgid "ENTER A LEVEL CODE"
msgstr "레벨 코드 입력"

#. Drafting table note: the three steps of making a level
msgid "DRAW A LEVEL · BEAT IT · SHARE ITS CODE"
msgstr "레벨 그리기 · 클리어 · 코드 공유"

#. Drafting table note after beating a level a friend sent: the seconds left on the clock (%d)
msgid "LEVEL CLEARED WITH %ds LEFT"
msgstr "레벨 클리어: %d초 남음"

#. Sheet title: the screen for typing or pasting a level code
msgid "LEVEL CODE"
msgstr "레벨 코드"

#. Level code sheet: instruction above the text box
msgid "TYPE OR PASTE A LEVEL CODE"
msgstr "레벨 코드를 입력하거나 붙여넣기"

#. Level code sheet button: paste the clipboard into the text box
msgid "PASTE"
msgstr "붙여넣기"

#. Level code sheet item: play the level the code describes
msgid "PLAY THIS LEVEL"
msgstr "이 레벨 플레이"

#. Level code sheet: the code has a typo or isn't a level code
msgid "THAT CODE DOESN'T READ. CHECK IT AND TRY AGAIN"
msgstr "코드를 읽을 수 없습니다. 확인 후 다시 시도"

#. Level code sheet: the code was made by a later version of the game. Keep MAPMAN.
msgid "THIS LEVEL NEEDS A NEWER VERSION OF MAPMAN"
msgstr "이 레벨은 새 버전의 MAPMAN이 필요합니다"

#. Sheet title shown when the game opens with a copied level code: offer to play it
msgid "A LEVEL CODE IS ON THE CLIPBOARD"
msgstr "레벨 코드가 복사되어 있습니다"

#. Item: play the level from the copied code
msgid "PLAY IT"
msgstr "플레이"

#. Item: ignore the copied code
msgid "NOT NOW"
msgstr "나중에"

#. Editor title: which of the six drafts is open (%d is 1 to 6)
msgid "DRAFT %d"
msgstr "초안 %d"

#. Editor button: leave the editor (the draft is kept)
msgid "BACK"
msgstr "뒤로"

#. Editor button: take back the last stroke
msgid "UNDO"
msgstr "실행 취소"

#. Editor button: play the draft; reaching an exit signs it
msgid "TEST"
msgstr "테스트"

#. Editor button: show the draft's code and QR code (only once it is signed)
msgid "SHARE"
msgstr "공유"

#. Editor: small label over the meter showing how long the draft's code is
msgid "CODE"
msgstr "코드"

#. Editor status: the draft has no start tile yet
msgid "PLACE ONE START TILE"
msgstr "시작 타일을 하나 놓으세요"

#. Editor status: the draft has no exit yet
msgid "PLACE AT LEAST ONE EXIT"
msgstr "출구를 하나 이상 놓으세요"

#. Editor status: the draft can be played; beating it signs it so it can be shared
msgid "TEST IT AND REACH AN EXIT TO SIGN IT"
msgstr "테스트해서 출구에 닿으면 서명됩니다"

#. Editor status: the draft has been beaten and can be shared
msgid "SIGNED · READY TO SHARE"
msgstr "서명됨 · 공유 가능"

#. Editor: name of a vanishing tile, which disappears for %d moves after MapMan steps off it
msgid "VANISH · %d MOVE"
msgid_plural "VANISH · %d MOVES"
msgstr[0] "사라짐 · %d칸"

#. Share sheet: how a friend gets the level, with no accounts or internet: scan the QR code or send the text code
msgid "SCAN THE QR WITH A PHONE CAMERA, OR SEND THE CODE"
msgstr "휴대폰 카메라로 QR을 스캔하거나 코드를 보내세요"

#. Share sheet item: copy the level code to the clipboard
msgid "COPY CODE"
msgstr "코드 복사"

#. Share sheet: confirms the code is on the clipboard
msgid "CODE COPIED"
msgstr "코드 복사됨"

#. Share sheet item: return to the editor
msgid "BACK TO THE DRAFT"
msgstr "초안으로 돌아가기"

#. Pause sheet while testing a draft (%d is 1 to 6). Same wording as WORK SUSPENDED · TUTORIAL.
msgid "WORK SUSPENDED · DRAFT %d"
msgstr "작업 중단 · 초안 %d"

#. Pause sheet while playing a level from a code. Same wording as WORK SUSPENDED · TUTORIAL.
msgid "WORK SUSPENDED · RECEIVED LEVEL"
msgstr "작업 중단 · 받은 레벨"

#. Editor palette: clears tiles
msgid "ERASER"
msgstr "지우개"

#. Editor palette: a plain tile MapMan can walk on
msgid "PATH"
msgstr "길"

#. Editor palette: where MapMan starts (one per level)
msgid "START TILE"
msgstr "시작 타일"

#. Editor palette: a level exit (one for each direction)
msgid "EXIT"
msgstr "출구"

#. Editor palette: a tile that costs a life
msgid "DEATH TILE"
msgstr "독 타일"

#. Editor palette: a star to collect
msgid "STAR"
msgstr "별"

#. Editor palette: a tile that holds MapMan until the player shakes or taps
msgid "STICKY TILE"
msgstr "끈끈이 타일"

#. Editor palette: a tile that reverses the controls
msgid "REVERSE TILE"
msgstr "반전 타일"

#. Editor palette: a tile that hides the hideable tiles when stepped on
msgid "HIDE TILES"
msgstr "타일 숨기기"

#. Editor palette: a tile that shows the hidden tiles again
msgid "UNHIDE TILES"
msgstr "타일 다시 표시"

#. Editor palette: a path tile that is never drawn
msgid "INVISIBLE PATH"
msgstr "보이지 않는 길"

#. Editor palette: a star that disappears while tiles are hidden
msgid "HIDEABLE STAR"
msgstr "숨는 별"

#. Editor palette: a death tile that disappears while tiles are hidden
msgid "HIDEABLE DEATH TILE"
msgstr "숨는 독 타일"

#. Editor palette: an extra life that disappears while tiles are hidden
msgid "HIDEABLE EXTRA LIFE"
msgstr "숨는 목숨 추가"

#. Editor palette: marks tiles that are hidden when the level begins
msgid "STARTS HIDDEN"
msgstr "처음엔 숨김"

#. Screen reader: a draft slot with nothing in it (%d is 1 to 6)
msgid "Draft %d, empty"
msgstr "초안 %d, 비어 있음"

#. Screen reader: a draft slot with a level not yet beaten
msgid "Draft %d"
msgstr "초안 %d"

#. Screen reader: a draft its maker has beaten, ready to share
msgid "Draft %d, signed"
msgstr "초안 %d, 서명됨"

#. Screen reader: a level a friend sent (%d counts them)
msgid "Received level %d"
msgstr "받은 레벨 %d"

#. Screen reader: the text box for a level code
msgid "Level code"
msgstr "레벨 코드"

#. Screen reader: the QR code picture on the share sheet
msgid "QR code of the level"
msgstr "레벨 QR 코드"

#. Editor palette: a tile that falls away once MapMan steps off it
msgid "CRUMBLE TILE"
msgstr "무너지는 타일"

#. Editor button: wipe the whole grid (UNDO brings it back)
msgid "CLEAR"
msgstr "지우기"

#. Drafting table item and sheet title: point the phone's camera at a friend's level QR code to play it
msgid "SCAN A QR CODE"
msgstr "QR 코드 스캔"

#. Scan sheet: instruction at the top. The share sheet is the screen in a friend's game that shows their level's QR code
msgid "POINT THE CAMERA AT THE QR CODE ON A FRIEND'S SHARE SHEET"
msgstr "친구의 공유 시트에 있는 QR 코드에 카메라를 맞추세요"

#. Scan sheet: status while the camera is on and no code has been read yet
msgid "LOOKING FOR A QR CODE…"
msgstr "QR 코드를 찾는 중…"

#. Scan sheet: status when the device has no camera the game can use
msgid "NO CAMERA FOUND"
msgstr "카메라를 찾을 수 없습니다"

#. Scan sheet: status when the player refused the camera permission; they can allow it in the phone's settings
msgid "MAPMAN ISN'T ALLOWED TO USE THE CAMERA. ALLOW IT IN THE PHONE'S SETTINGS"
msgstr "MAPMAN이 카메라를 사용할 수 없습니다. 휴대폰 설정에서 허용하세요"

#. Scan sheet: status when the camera read a QR code that holds something else
msgid "THAT QR CODE ISN'T A MAPMAN LEVEL"
msgstr "그 QR 코드는 MAPMAN 레벨이 아닙니다"

#. Scan sheet item: go to the screen for typing a level code instead of scanning
msgid "TYPE A CODE INSTEAD"
msgstr "코드 직접 입력"

#. Screen reader: the live picture from the camera on the scan sheet
msgid "Camera view"
msgstr "카메라 화면"

#. Editor palette: an ice tile; MapMan slides across it until something stops him
msgid "ICE"
msgstr "얼음"

#. Editor palette: spikes that rise and fall on a beat; touching them while up costs a life
msgid "SPIKES"
msgstr "가시"

#. Editor palette: spikes that rise and fall half a beat after the others, so rows of them make a wave
msgid "OFF-BEAT SPIKES"
msgstr "엇박 가시"

#. Options row and sheet title: how MapMan is steered (tilting the device or the on-screen touch stick)
msgid "CONTROLS"
msgstr "조작"

#. Options value: MapMan is steered by tilting the device
msgid "TILT"
msgstr "기울기"

#. Options value: MapMan is steered with the on-screen touch stick
msgid "TOUCH"
msgstr "터치"

#. Controls row: steer with an on-screen stick that appears where a finger touches and drags
msgid "DRAG TO MOVE"
msgstr "드래그해서 이동"

#. Controls row: how little tilt moves MapMan
msgid "TILT SENSITIVITY"
msgstr "기울기 감도"

#. Tilt sensitivity value: needs more tilt
msgid "LOW"
msgstr "낮음"

#. Tilt sensitivity value: the default
msgid "NORMAL"
msgstr "보통"

#. Tilt sensitivity value: needs less tilt
msgid "HIGH"
msgstr "높음"

#. Pause sheet small print when steering with the touch stick
msgid "NOTE: DRAG TO MOVE · TAP THE SHEET TO PAUSE"
msgstr "주: 드래그해서 이동 · 도면을 탭하면 일시정지"

#. Tutorial lesson 1 when steering with the touch stick (two lines, up to about 85 characters a line)
msgid ""
"Touch and drag anywhere to move around the map and head for the exit tile.\n"
"Drag past the dashed ring to walk, past the solid ring to run."
msgstr ""
"아무 곳이나 터치하고 드래그해 이동하고 출구 타일로 가세요.\n"
"점선 원을 넘으면 걷기, 실선 원을 넘으면 달리기."

#. Tutorial lesson 11 when steering with the touch stick
msgid "Tap the screen during play to pause. Only a quick tap pauses: a touch that drags moves MapMan."
msgstr "플레이 중 화면을 탭하면 일시정지됩니다. 짧게 탭할 때만 일시정지되고, 드래그하면 MapMan이 움직입니다."

#. Controls sheet value on the greyed-out tilt rows while steering by touch: the setting only applies to tilt
msgid "TILT ONLY"
msgstr "기울기 전용"

#. Level card: this level was drawn on this phone
msgid "MADE BY YOU"
msgstr "내가 만든 레벨"

#. Level card: this level came from someone else's code
msgid "FROM A FRIEND"
msgstr "친구에게서"

#. Level card title: a level a friend sent (%d is its number on the drafting table, 1 to 12)
msgid "RECEIVED LEVEL %d"
msgstr "받은 레벨 %d"

#. Level card figure label: how many tries the level has had
msgid "PLAYED"
msgstr "플레이 횟수"

#. Level card figure label: how many times it was won
msgid "CLEARED"
msgstr "클리어 횟수"

#. Level card figure label: the best time
msgid "BEST"
msgstr "최고"

#. Level card figure: the best time, as seconds left on the clock (%d)
msgid "%ds LEFT"
msgstr "%d초 남음"

#. Level card button: play this level
msgid "PLAY"
msgstr "플레이"

#. Level card button: open the draft in the editor
msgid "EDIT"
msgstr "편집"

#. Level card button: copy a friend's level into an empty draft, to change it
msgid "REMIX"
msgstr "리믹스"

#. Level card button, and the button that confirms it: remove the level for good
msgid "DELETE"
msgstr "삭제"

#. Level card button: give the level a name that only this player sees
msgid "RENAME"
msgstr "이름 변경"

#. Replay heading for a drafting table level: its name (%s)
msgid "REPLAY — %s"
msgstr "리플레이 — %s"

#. Delete question button: don't delete
msgid "KEEP IT"
msgstr "유지"

#. Share sheet item: back to the level's card
msgid "BACK TO THE LEVEL"
msgstr "레벨로 돌아가기"

#. Delete question (%d is the draft's number, 1 to 6)
msgid "DELETE DRAFT %d?"
msgstr "초안 %d 삭제?"

#. Delete question for a level a friend sent (%d is its number, 1 to 12)
msgid "DELETE RECEIVED LEVEL %d?"
msgstr "받은 레벨 %d 삭제?"

#. Delete question note, under the question; wraps onto two lines
msgid "ITS NAME, BEST TIME AND GHOST GO WITH IT. THIS CAN'T BE UNDONE"
msgstr "이름, 최고 기록, 고스트도 함께 사라집니다. 되돌릴 수 없습니다"

#. Rename sheet: the name stays on this phone and is never sent with the level's code
msgid "NAME THIS LEVEL · ONLY YOU SEE IT"
msgstr "레벨 이름 짓기 · 나만 볼 수 있음"

#. Rename sheet button
msgid "SAVE THE NAME"
msgstr "이름 저장"

#. Level card note when no draft is empty, so REMIX can't copy the level
msgid "ALL 6 DRAFTS ARE IN USE: DELETE ONE TO REMIX"
msgstr "초안 6개가 모두 사용 중: 하나를 삭제하세요"

#. Level card note after a win with more time left than ever before (%d seconds)
msgid "CLEARED WITH %ds LEFT · NEW BEST"
msgstr "%d초 남기고 클리어 · 최고 기록"

#. Screen reader: the text box for a level's name
msgid "Level name"
msgstr "레벨 이름"

#. Screen reader: the picture of the level on its card
msgid "The level's map"
msgstr "레벨 지도"
