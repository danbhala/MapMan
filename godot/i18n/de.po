msgid "LEVEL %d: %ds LEFT"
msgstr "LEVEL %d: %ds ÜBRIG"

#. Practice result caption
msgid "LEVEL %d: %ds LEFT, NEW BEST!"
msgstr "LEVEL %d: %ds ÜBRIG, REKORD!"

#. Floating note on an extra-time tile: five seconds
msgid "+5 S"
msgstr "+5 S"

#. Floating note on a time-loss tile; keep the minus sign U+2212
msgid "−5 S"
msgstr "−5 S"

#. Screen reader name of the practice page arrow
msgid "Previous page"
