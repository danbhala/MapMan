; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

# MapMan's AdMob app (scripts/ads.gd has its ad units). The plugin's other
# settings keep their defaults; addons/admob/MAPMAN.md has the two lines
# changed in it.
general/android/app_id="ca-app-pub-4967250367903621~8364718860"

[application]

config/name="MapMan"
config/name.dev="MapMan Dev"
config/description="Tilt-to-move tile maze game, ported from the Pythonista original."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://assets/man/idle/front.png"
boot_splash/bg_color=Color(0.0862745, 0.25098, 0.478431, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[internationalization]

locale/translations=PackedStringArray("res://i18n/es.po", "res://i18n/pt_BR.po", "res://i18n/fr.po", "res://i18n/it.po", "res://i18n/de.po", "res://i18n/ga.po", "res://i18n/ru.po", "res://i18n/tr.po", "res://i18n/id.po", "res://i18n/ja.po", "res://i18n/ko.po", "res://i18n/zh_CN.po", "res://i18n/zh_TW.po", "res://i18n/ar.po")
rendering/root_node_layout_direction=1
# ICU line-break rules on the phone too, so Japanese and Chinese wrap as on the desktop.
locale/include_text_server_data=true

[autoload]

Save="*res://scripts/save.gd"
Audio="*res://scripts/audio.gd"
Dev="*res://scripts/dev.gd"
Ads="*res://scripts/ads.gd"

[display]

window/size/viewport_width=667
window/size/viewport_height=375
window/size/window_width_override=1334
window/size/window_height_override=750
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/level_links/plugin.cfg")

